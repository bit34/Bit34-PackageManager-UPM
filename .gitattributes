# ============================================================================
# Bit34-PackageManager-UPM — line ending policy
#
# This repo grew up with mixed line endings: roughly half its text blobs were
# stored CRLF and half LF, so files showed up as wholly modified depending on
# whose machine checked them out and what their core.autocrlf happened to be.
#
# Everything git detects as text is stored and checked out as LF, whatever the
# local git config says. Binary types are named explicitly below so that
# detection never has to be right about them.
# ============================================================================

* text=auto eol=lf


# ---- Binary: never touch the bytes ----------------------------------------
# None of these are in the repo today, but a Unity package picks them up
# sooner or later and a wrong guess here corrupts an asset.

*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.psd    binary
*.tga    binary
*.tif    binary
*.tiff   binary
*.ico    binary
*.exr    binary
*.hdr    binary

*.mp3    binary
*.ogg    binary
*.wav    binary
*.aif    binary
*.aiff   binary

*.fbx    binary
*.obj    binary
*.blend  binary
*.dae    binary
*.3ds    binary

*.ttf    binary
*.otf    binary

*.dll    binary
*.so     binary
*.dylib  binary
*.a      binary
*.pdb    binary

*.zip    binary
*.unitypackage binary


# ---- Note on Unity's YAML files --------------------------------------------
# .meta, .asset, .unity, .prefab and friends are YAML and are handled by the
# text=auto rule above — unless the project is set to Force Binary asset
# serialization, in which case git's own binary detection keeps them safe.
# They are deliberately not forced to `text` for that reason.
#
# Unity ships a smart merge tool (UnityYAMLMerge) that can be wired up with a
# `merge=unityyamlmerge` attribute, but that needs a matching merge driver in
# each machine's git config, so it is left out here.
